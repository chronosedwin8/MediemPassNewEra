# =============================================================================
# Medienpass — plantilla de variables de entorno
# Copiar a `.env` y rellenar. NUNCA versionar el `.env` real ni valores reales.
# =============================================================================

# --- Aplicación ---------------------------------------------------------------
NODE_ENV=development
APP_NAME=Medienpass
APP_URL=http://localhost:5173
PORT=3000
DEFAULT_LANGUAGE=es
LOG_LEVEL=debug

# --- Base de datos ------------------------------------------------------------
# PostgreSQL 17. La base de test se resetea en cada corrida de integración.
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/medienpass_dev?schema=public
DATABASE_URL_TEST=postgresql://usuario:contrasena@localhost:5432/medienpass_test?schema=public

# --- Autenticación ------------------------------------------------------------
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-48-bytes
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=cambiar-por-otro-secreto-aleatorio-distinto-del-anterior
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_SECRET=cambiar-por-un-tercer-secreto-aleatorio

# --- SSO: Microsoft Entra ID (OIDC) -------------------------------------------
# Convive con el acceso por correo y contraseña: son dos formas de demostrar la
# misma identidad, no dos cuentas. Con SSO_ENABLED=false solo se ofrece el
# acceso con credenciales.
#
# De la matrícula real, 94 de 1.177 estudiantes no pueden usar SSO: 20 no tienen
# correo y el resto usa cuentas personales. Por eso ambos caminos son necesarios.
SSO_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/sso/entra/callback
# Dominios de correo aceptados por SSO, separados por coma.
SSO_ALLOWED_DOMAINS=colegioaleman.edu.co

# --- CORS ---------------------------------------------------------------------
# Lista blanca separada por comas. Nunca usar "*" con credenciales.
CORS_ORIGIN=http://localhost:5173

# --- Integración Phidias ------------------------------------------------------
# El token JAMÁS debe salir del backend: ni al navegador, ni a logs, ni a
# respuestas de la API, ni a proxies de terceros.
PHIDIAS_BASE_URL=https://ds-barranquilla.phidias.co/rest
PHIDIAS_TOKEN=
# live = API real | mock = fixtures anonimizados (desarrollo y tests)
PHIDIAS_MODE=mock
PHIDIAS_TIMEOUT_MS=30000
PHIDIAS_RETRIES=2
PHIDIAS_CACHE_TTL_SECONDS=300
# ATENCIÓN: en Phidias `year` es un identificador interno (1..6), NO el año
# calendario. El año escolar 2026-2027 corresponde a year=6.
PHIDIAS_ACADEMIC_YEAR_ID=6

# --- Inteligencia artificial --------------------------------------------------
# google | anthropic | openai | mock
#
# `mock` NO genera preguntas: devuelve relleno con la forma correcta pero sin
# relación con el tema. Sirve para probar el flujo y para que las pruebas no
# dependan de la red. La interfaz avisa cuando está activo.
AI_PROVIDER=mock
AI_API_KEY=
#
# Medido con este prompt, generando 20 preguntas:
#   gemini-2.5-pro    ~50 s   sigue mejor las indicaciones del docente
#   gemini-2.5-flash  ~15 s   correcto, pero más genérico
#
# Se prefiere `pro` porque el campo de contexto es la razón de ser de esta
# función: con `flash` las preguntas salen bien pero ignoran buena parte de lo
# que el docente escribió. Si la espera resulta excesiva, `flash` es la
# alternativa razonable.
AI_MODEL=gemini-2.5-pro
# 30 preguntas con `pro` tardan unos 83 s medidos. El margen es deliberado: el
# coste de esperar de más es un docente impaciente; el de quedarse corto, una
# generación perdida después de minuto y medio.
AI_TIMEOUT_MS=180000
AI_MAX_QUESTIONS_PER_REQUEST=30
AI_RATE_LIMIT_PER_USER_PER_DAY=50

# --- Caché --------------------------------------------------------------------
# memory | redis
CACHE_DRIVER=memory
REDIS_URL=

# --- Límite de peticiones -----------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Valor pensado para producción. En desarrollo conviene subirlo: probar el
# login media docena de veces agota diez intentos enseguida.
RATE_LIMIT_AUTH_MAX=10

# --- Despliegue con Docker Compose --------------------------------------------
# Solo los usa `docker/docker-compose.yml`. En desarrollo local, con PostgreSQL
# instalado en la máquina, no hacen falta: basta con DATABASE_URL.
#
# El compose construye DATABASE_URL a partir de estos tres valores, de modo que
# la contraseña de la base vive en un único sitio.
POSTGRES_USER=medienpass
POSTGRES_PASSWORD=cambiar-por-una-contrasena-larga-y-aleatoria
POSTGRES_DB=medienpass
# Puerto por el que se publica la aplicación en el anfitrión.
WEB_PORT=8080

# --- Almacenamiento de archivos -----------------------------------------------
# s3 = Amazon S3 | memory = en memoria (desarrollo y pruebas, no persiste)
STORAGE_DRIVER=memory
S3_BUCKET=
S3_REGION=us-east-2
# Credenciales IAM con permiso sobre ESE bucket y nada más.
# NUNCA se versionan y NUNCA salen del backend: el navegador sube con URL
# firmada, así que la clave no llega al cliente en ningún momento.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Caducidad de las URLs firmadas. Corta a propósito: una URL de descarga que
# dura horas es un enlace público con retraso.
S3_UPLOAD_URL_TTL_SECONDS=300
S3_DOWNLOAD_URL_TTL_SECONDS=300
# 25 MiB. El límite se aplica en la propia firma, no solo en el navegador.
S3_MAX_UPLOAD_BYTES=26214400

# --- ElevenLabs: narracion de los videos de capacitacion ---------------------
# Solo la usa la herramienta `npm run -w backend videos`, nunca el servidor:
# generar los videos es produccion de contenido, no algo que la plataforma haga
# mientras atiende peticiones. No se imprime ni al fallar.
ELEVENLABS_API_KEY=
# La misma voz en los seis modulos. Por defecto, una voz colombiana.
ELEVENLABS_VOICE_ID=
