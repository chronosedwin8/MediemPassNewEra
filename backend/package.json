{
  "name": "@medienpass/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "db:reset": "dotenv -e ../.env -- prisma migrate reset --force",
    "db:studio": "dotenv -e ../.env -- prisma studio",
    "db:seed": "tsx --env-file=../.env prisma/seed/index.ts",
    "db:seed:dist": "node dist/seed.js",
    "phidias:probe": "tsx --env-file=../.env tools/phidias-probe.ts",
    "phidias:fixtures": "tsx --env-file=../.env tools/build-fixtures.ts",
    "videos": "tsx --env-file=../.env tools/videos-capacitacion.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "videos:aplicar": "tsx --env-file=../.env tools/videos-aplicar.ts",
    "admin:crear": "tsx --env-file=../.env tools/crear-administrador.ts"
  },
  "prisma": {
    "seed": "tsx --env-file=../.env prisma/seed/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@medienpass/shared": "*",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "openid-client": "^6.1.7",
    "pdfkit": "^0.15.2",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "prisma": "^6.2.1",
    "sanitize-html": "^2.17.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vitest": "^3.2.7"
  }
}
