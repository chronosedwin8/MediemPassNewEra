# =============================================================================
# Backend — imagen de producción
#
# Tres etapas. La razón de que sean tres y no una: la imagen final no debe
# contener ni el código fuente, ni las dependencias de desarrollo, ni el
# compilador. Lo que no está instalado no se puede aprovechar.
# =============================================================================

# --- 1 · Dependencias --------------------------------------------------------
# En capa propia para que un cambio en el código no invalide `npm ci`, que es
# con diferencia el paso más lento.
FROM node:24-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY packages/shared/package.json ./packages/shared/

# Solo los espacios de trabajo que esta imagen necesita.
#
# Antes ponía `--workspaces`, que instala también el frontend: Vite, Vue,
# ECharts, Tiptap y el resto de la cadena de compilación web, dentro de la
# imagen de la API, que no usa ni una de esas dependencias. En un servidor
# pequeño eso no es solo tiempo, es memoria que compite con las otras etapas
# que se construyen a la vez.
RUN npm ci --workspace backend --workspace packages/shared --include-workspace-root


# --- 2 · Compilación ---------------------------------------------------------
FROM deps AS build
WORKDIR /app

COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY backend ./backend

# El cliente de Prisma se genera antes de compilar: el código lo importa.
RUN npm run db:generate --workspace backend \
 && npm run build --workspace backend


# --- 3 · Ejecución -----------------------------------------------------------
FROM node:24-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production

# `dumb-init` como PID 1: Node no reenvía las señales a sus hijos, y sin esto
# un `docker stop` mata el contenedor en seco en lugar de dejar que el
# servidor cierre sus conexiones.
RUN apk add --no-cache dumb-init

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY packages/shared/package.json ./packages/shared/

RUN npm ci --omit=dev --workspace backend --include-workspace-root \
 && npm cache clean --force

COPY --from=build /app/backend/dist ./backend/dist
COPY --from=build /app/packages/shared ./packages/shared
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /app/node_modules/@prisma ./node_modules/@prisma

# Las migraciones viajan con la imagen: `db:deploy` se ejecuta al arrancar y
# necesita el mismo historial con el que se compiló.
COPY backend/prisma ./backend/prisma

# Usuario sin privilegios. La imagen de Node ya trae `node` (uid 1000).
USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "backend/dist/server.js"]
