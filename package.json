{
  "name": "medienpass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de evaluación académica y competencias digitales KMK",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace packages/shared && npm run build --workspace backend && npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,json,md,css}\"",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:reset": "npm run db:reset --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "db:studio": "npm run db:studio --workspace backend",
    "phidias:probe": "npm run phidias:probe --workspace backend",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vue-eslint-parser": "^9.4.3"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
